
<!DOCTYPE html>
<html>
<head>
    <title>Task 7 - DOM Manipulation</title>
    <link rel="stylesheet" href="style.css">
</head><style>

body {
    font-family: Arial;
    background-color: lightblue;
    text-align: center;
}

h1 {
    color: darkblue;
}

/* To Do List */

.todo {
    background: white;
    width: 500px;
    margin: 30px auto;
    padding: 20px;
    border-radius: 10px;
}

input {
    padding: 10px;
    width: 60%;
}

button {
    padding: 10px;
    background: green;
    color: white;
    border: none;
    cursor: pointer;
}

li {
    margin: 15px;
    font-size: 18px;
}

.delete {
    background: red;
    margin-left: 15px;
}

/* Image Gallery */

.gallery {
    background: white;
    width: 600px;
    margin: 30px auto;
    padding: 20px;
    border-radius: 10px;
}

#bigImage {
    width: 100%;
    height: 350px;
    object-fit: cover;
    border-radius: 10px;
}

.thumbnails {
    display: flex;
    gap: 10px;
    margin-top: 15px;
}

.thumb {
    width: 25%;
    height: 100px;
    object-fit: cover;
    cursor: pointer;
    border: 3px solid transparent;
    border-radius: 5px;
}

.thumb:hover {
    border: 3px solid blue;
    transform: scale(1.05);
}</style>

<body>

    <h1>Interactive Applications</h1>

    <!-- TO DO LIST -->
    <div class="todo">

        <h2>My To-Do List</h2>

        <input type="text" id="taskInput"
        placeholder="Enter your task">

        <button id="addBtn">Add Task</button>

        <ul id="taskList"></ul>

    </div>


    <!-- IMAGE GALLERY -->
    <div class="gallery">

        <h2>My Image Gallery</h2>

        <!-- Main Image -->
        <div>
            <img id="bigImage"
            src="https://picsum.photos/id/1015/800/450">
        </div>

        <!-- Four Thumbnails -->
        <div class="thumbnails">

            <img class="thumb"
            src="https://picsum.photos/id/1016/200/120">

            <img class="thumb"
            src="https://picsum.photos/id/1018/200/120">

            <img class="thumb"
            src="https://picsum.photos/id/1020/200/120">

            <img class="thumb"
            src="https://picsum.photos/id/1024/200/120">

        </div>

    </div>

    <script src="script.js"></script>
    <script>
/* TO DO LIST */

 
let input = document.getElementById("taskInput");
let button = document.getElementById("addBtn");
let list = document.getElementById("taskList");

 k
button.addEventListener("click", function() {

    let task = input.value.trim();

    if (task === "") {
        alert("Please enter a task");
        return;
    }

     
    let li = document.createElement("li");

    li.innerText = task;

     
    let deleteBtn = document.createElement("button");

    deleteBtn.innerText = "Delete";
    deleteBtn.className = "delete";

     
    deleteBtn.addEventListener("click", function() {
        li.remove();
    });

    li.appendChild(deleteBtn);

    
    list.appendChild(li);

    input.value = "";

});


/* IMAGE GALLERY */


let bigImage = document.getElementById("bigImage");

// Select all thumbnails
let thumbnails = document.querySelectorAll(".thumb");

// Add click event
thumbnails.forEach(function(image) {

    image.addEventListener("click", function() {

        // Update main image
        bigImage.src = image.src.replace("/200/120", "/800/450");

    });

});

</script>
</body>
</html>
