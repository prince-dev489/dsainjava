<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link rel="stylesheet" href="style.css">

    <title>Space Explorer</title>
</head>
<section>body {
    background-color: rgb(18, 18, 18) ;
    color: rgb(255, 255, 255);
}
.navbar {
    background-color: rgb(5, 5, 5) ;
}
.nav-link {
    color: rgb(255, 255, 255) ;
    transition: 0.3s;
}
.nav-link:hover {
    color: rgb(0, 217, 255) ;
}
.hero {
    min-height: 85vh;
    display: flex;
    align-items: center;
}
.hero h1 {
    font-size: 45px;
    font-weight: bold;
}
.hero p {
    color: rgb(180, 185, 195);
}
.space {
    position: relative;
    width: 300px;
    height: 300px;
    margin: auto;
}
.astronaut {
    position: absolute;
    font-size: 100px;
    left: 90px;
    top: 80px;
    animation: astronautMove 3s ease-in-out infinite;
}
@keyframes astronautMove {
    0% {
        transform: translateY(0);
    }
    50% {
        transform: translateY(-25px);
    }
    100% {
        transform: translateY(0);
    }
}
.rocket {
    position: absolute;
    font-size: 40px;
    left: 80px;
    top: 60px;
    animation: rocketMove 3s ease-in-out infinite;
}
@keyframes rocketMove {

    0% {
        transform: translate(0px, 20px) rotate(-20deg);
    }
    50% {
        transform: translate(55px, -20px) rotate(20deg);
    }
    100% {
        transform: translate(0px, 20px) rotate(-20deg);
    }
}
.btn-space {
    background-color: rgb(0, 217, 255);
    color: rgb(0, 0, 0);
    border: none;
}
.btn-space:hover {
    background-color: rgb(255, 255, 255);
    color: rgb(0, 0, 0);
}
@media (max-width: 991px) {
    .hero {
        text-align: center;
        padding: 50px 20px;
    }
    .hero h1 {
        font-size: 35px;
    }
    .space {
        margin-top: 30px;
    }
}
@media (max-width: 576px) {
    .hero h1 {
        font-size: 30px;
    }
    .space {
        width: 250px;
        height: 250px;
    }
    .astronaut {
        font-size: 80px;
        left: 75px;
        top: 70px;
    }
    .rocket {
        font-size: 32px;
        left: 70px;
        top: 55px;
    }
}
</section>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark">

        <div class="container">

            <a class="navbar-brand" href="#">
                🚀 Space Explorer
            </a>
            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarMenu">

                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarMenu">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="#home">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#about">About</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#mission">Mission</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#contact">Contact Us</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <section id="home" class="hero">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6">
                    <h1>
                        Explore the Space 🚀
                    </h1>
                    <p class="mt-3">
                        Discover the universe with technology,
                        innovation and curiosity.
                    </p>
                    <button class="btn btn-space mt-3">
                        Explore Mission
                    </button>
                </div>
                <div class="col-lg-6">
                    <div class="space">
                        <div class="astronaut">
                            👨‍🚀
                        </div>
                        <div class="rocket">
                            🚀
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="about" class="py-5">
        <div class="container text-center">
            <h2>About</h2>
            <p>
                A simple responsive space-themed website
                created using Bootstrap and CSS animations.
            </p>
        </div>
    </section>
    <section id="mission" class="py-5">
        <div class="container text-center">
            <h2>Mission</h2>
            <p>
                Our mission is to explore, discover and innovate.
            </p>
        </div>
    </section>
    <section id="contact" class="py-5">

        <div class="container text-center">
            <h2>Contact Us</h2>
            <p>
                Let's explore the future together!
            </p>
        </div>
    </section>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

</body>
</html>
